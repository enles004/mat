FROM ghcr.io/astral-sh/uv:0.11.16 AS uv
FROM python:3.12-slim

COPY --from=uv /uv /uvx /bin/
WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_LINK_MODE=copy \
    UV_CACHE_DIR=/tmp/uv-cache \
    HF_HOME=/app/.hf-cache

RUN apt-get update \
    && apt-get install -y --no-install-recommends git libgomp1 \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --system --uid 10001 --user-group --create-home mat \
    && mkdir -p /app/runs /app/reports /app/.hf-cache \
    && chown mat:mat /app/runs /app/reports /app/.hf-cache

COPY --chown=10001:10001 ai/pyproject.toml ai/uv.lock ./
RUN --mount=type=cache,target=/tmp/uv-cache \
    uv sync --locked --extra transformer --no-dev --no-install-project

COPY --chown=10001:10001 ai/main.py ai/config.py ./
COPY --chown=10001:10001 ai/src ./src
COPY --chown=10001:10001 ai/scripts ./scripts
COPY --chown=10001:10001 ai/configs ./configs
COPY --chown=10001:10001 ai/data ./data
COPY --chown=10001:10001 ai/artifacts ./artifacts
RUN --mount=type=cache,target=/tmp/uv-cache \
    uv sync --locked --extra transformer --no-dev --no-editable

# The lock pins torch to the CPU wheel (see pyproject.toml — the CPU serving
# image must stay small). This is the GPU bootstrap: reinstall the CUDA 13
# build (cu130, the same stack the PyPI default resolved to for torch 2.14.0;
# sm_120 Blackwell GPUs need CUDA >= 12.8) over the synced venv.
RUN --mount=type=cache,target=/tmp/uv-cache \
    uv pip install --python /app/.venv/bin/python "torch==2.14.0+cu130" \
        --index-url https://download.pytorch.org/whl/cu130 --reinstall

ARG GIT_REVISION=""
ENV MAT_GIT_REVISION=${GIT_REVISION}

USER mat
EXPOSE 8000
ENTRYPOINT ["sh", "-c", "uv run --no-sync --extra transformer python scripts/release_train_and_serve.py && exec uv run --frozen --no-sync uvicorn main:app --host 0.0.0.0 --port 8000"]
